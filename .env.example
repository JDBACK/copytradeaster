# copytradeaster settings (prefix CT_, loaded from .env)
# Generate encryption key: python -c "import secrets; print(secrets.token_hex(32))"

# REST base (futures testnet)
CT_REST_BASE_URL=https://fapi.asterdex-testnet.com
# User-data stream base (listenKey appended)
CT_WS_USER_BASE=wss://fstream.asterdex-testnet.com/ws
# SQLite database file (created on first run; git-ignored)
CT_DB_PATH=data/copytrade.sqlite3
# REQUIRED: hex key decoding to 32 bytes for AES-256-GCM credential storage
CT_ENCRYPTION_KEY=

# Logging level
CT_LOG_LEVEL=INFO
# Persistent local application log (created automatically on restart)
CT_LOG_PATH=data/logs/copytradeaster.log
# Rotation bounds: 10 MiB current file plus five backups
CT_LOG_MAX_BYTES=10485760
CT_LOG_BACKUP_COUNT=5
# Periodic reconciliation sweep interval, seconds
CT_RECONCILE_INTERVAL_S=15
# listenKey keepalive interval, minutes (must stay below the 60 min TTL)
CT_LISTENKEY_KEEPALIVE_MIN=50

# Rate limits (mainnet values as defaults; testnet may report sentinel -2)
CT_WEIGHT_LIMIT_PER_MIN=2400
CT_ORDERS_LIMIT_PER_MIN=1200
CT_ORDERS_LIMIT_PER_10S=300

# Fee+slippage buffer applied to stop distance when sizing positions
CT_FEE_BUFFER_PCT=0.001
# Trigger price type for follower protective orders: MARK_PRICE | CONTRACT_PRICE
CT_WORKING_TYPE=MARK_PRICE
# Account position mode: ONE_WAY | HEDGE
CT_POSITION_MODE=ONE_WAY
# Master symbols eligible for copying (JSON list)
CT_SYMBOL_WHITELIST=["BTCUSDT", "ETHUSDT"]

# Registration context (ApproveAgent/ApproveBuilder), signed by the main wallet
CT_REGISTRATION_CHAIN_ID=56
# Builder address; empty -> approve_agent goes without builder fields
CT_BUILDER_ADDRESS=
CT_BUILDER_NAME=copytradeaster
# Builder fee cap sent with approveBuilder (futures limit 0.001)
CT_MAX_FEE_RATE=0.0001

# True: commands are planned and logged, no HTTP requests are sent
CT_DRY_RUN=false
# Stage 1 refuses non-testnet REST/WS URLs. Keep false; mainnet enablement is a
# separate future operational gate.
CT_ALLOW_MAINNET=false

# Explicit test/load adapters. SHADOW accounts never sign or send HTTP orders.
CT_SHADOW_ACCOUNTS_ENABLED=false
CT_SHADOW_AUTO_TRIGGER_CONDITIONALS=true

# Optional symbol-scoped follower snapshots. Empty uses authoritative
# all-symbol openOrders; for 10-30 followers keep empty unless measurements show
# the need. For a measured larger fan-out use the same symbols as the whitelist.
CT_FOLLOWER_SNAPSHOT_SYMBOLS=[]

# Telegram Stage 2 (preferred configuration; keep empty for Stage 1 CLI/core)
# The token is SecretStr-backed and is never included in redacted settings.
CT_TELEGRAM_BOT_TOKEN=
# Compatibility fallback: local ignored .botkey containing BOT_KEY=...
CT_TELEGRAM_BOT_KEY_FILE=.botkey
# JSON list is preferred; comma/space separated values are also accepted.
CT_TELEGRAM_ADMIN_IDS=[]
CT_TELEGRAM_POLLING_TIMEOUT_S=10
CT_TELEGRAM_TASKS_CONCURRENCY_LIMIT=16
CT_TELEGRAM_NOTIFICATIONS_ENABLED=true
CT_TELEGRAM_OUTBOX_POLL_INTERVAL_S=1
# JSON list or comma/space separated IPv4/CIDR values
CT_ASTER_EGRESS_IPS=[]
CT_REQUIRE_AGENT_IP_WHITELIST=true
# Testnet-only local development escape hatch; never valid on non-testnet URLs.
CT_TESTNET_IP_WHITELIST_OVERRIDE=false

# Stage 3 Mini App transport (aiohttp in the same process as the bot).
# Set CT_MINIAPP_ENABLED=true and point CT_MINIAPP_STATIC_DIR at the built
# Vite bundle (miniapp/dist).  For local dev, front the port with a tunnel:
#   scripts/dev-miniapp-tunnel.sh
# then set the resulting trycloudflare.com URL below — the bot installs it as
# the private-chat WebApp menu button on every start (no BotFather edits).
CT_MINIAPP_ENABLED=false
CT_MINIAPP_BIND_HOST=127.0.0.1
CT_MINIAPP_PORT=8080
CT_MINIAPP_STATIC_DIR=miniapp/dist
CT_MINIAPP_PUBLIC_URL=
# Signed initData older than this is rejected (Telegram signs once per launch)
CT_MINIAPP_INIT_DATA_TTL_S=86400
# Local dev ONLY (plain browser has no Telegram context): accept the declared
# CT_MINIAPP_DEV_USER_ID from the X-Dev-User-Id header instead of signed
# initData.  Refuses to work against any non-testnet REST base URL.
CT_MINIAPP_DEV_UNSIGNED=false
CT_MINIAPP_DEV_USER_ID=

# Stage 3 Builder flow (Mini App part 1).  CT_BUILDER_ADDRESS must be set for
# builder onboarding to start; empty keeps approve_agent going without builder.
CT_BUILDER_AGENT_EXPIRY_DAYS=30
CT_BUILDER_APPROVAL_TTL_S=600
